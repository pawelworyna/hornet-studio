<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);NU1902;NU1903;NETSDK1057</NoWarn>

    <!-- Central Versioning (SemVer 2.0.0) -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' != ''">$(VersionSuffix)</VersionSuffix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Assembly Metadata -->
    <Product>HornetStudio</Product>
    <Company>HornetStudio</Company>
    <Authors>pawelworyna; HornetStudio Contributors</Authors>
    <Copyright>Copyright © 2026 HornetStudio Contributors</Copyright>
    <RepositoryUrl>https://github.com/pawelworyna/hornet-studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
