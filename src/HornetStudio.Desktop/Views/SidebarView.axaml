<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HornetStudio.Desktop.ViewModels"
             xmlns:models="using:HornetStudio.Core.Domain.Models"
             xmlns:entities="using:HornetStudio.Core.Storage.Entities"
             x:Class="HornetStudio.Desktop.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

  <Border Background="#13171D"
          BorderBrush="#262D38"
          BorderThickness="0,0,1,0"
          Padding="10">
    <Grid RowDefinitions="Auto,Auto,*">
      <!-- Database / Schema Selector -->
      <Border Grid.Row="0"
              IsVisible="{Binding CanSwitchSchema}"
              Background="#171B22"
              BorderBrush="#262D38"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8,5"
              Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,8,0">
            <Path Width="13" Height="13" Stretch="Uniform" Fill="#10B981" Data="{StaticResource IconDatabase}" />
            <TextBlock Text="{Binding SchemaLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
          </StackPanel>

          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding AvailableSchemas}"
                    SelectedItem="{Binding SelectedSchema, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Background="#0F1216"
                    BorderBrush="#262D38"
                    BorderThickness="1"
                    CornerRadius="4"
                    FontSize="12"
                    Foreground="#38BDF8"
                    FontWeight="SemiBold"
                    Padding="8,4" />

          <Border Grid.Column="2"
                  Background="#0F1216"
                  BorderBrush="#262D38"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,3"
                  VerticalAlignment="Center"
                  Margin="6,0,0,0"
                  ToolTip.Tip="Total Tables in Active Schema">
            <TextBlock Text="{Binding FilteredTables.Count, StringFormat='{}{0} tbl'}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#10B981" />
          </Border>
        </Grid>
      </Border>

      <!-- Search Box & Refresh -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
        <TextBox Grid.Column="0"
                 Text="{Binding FilterText}"
                 PlaceholderText="Filter tables, views..."
                 Background="#0F1216"
                 BorderBrush="#262D38"
                 Foreground="#F1F5F9"
                 FontSize="12"
                 Padding="8,6"
                 CornerRadius="4"
                 Margin="0,0,6,0" />

        <Button Grid.Column="1"
                Command="{Binding OpenTableBuilderCommand}"
                Background="#1A2029"
                BorderBrush="#262D38"
                BorderThickness="1"
                Padding="8,6"
                CornerRadius="4"
                Margin="0,0,4,0"
                ToolTip.Tip="Create New Table">
          <Path Width="12" Height="12" Stretch="Uniform" Fill="#10B981" Data="{StaticResource IconAdd}" />
        </Button>

        <Button Grid.Column="2"
                Command="{Binding RefreshCommand}"
                Background="#1A2029"
                BorderBrush="#262D38"
                BorderThickness="1"
                Padding="8,6"
                CornerRadius="4"
                ToolTip.Tip="Refresh Database Schema">
          <Path Width="14" Height="14" Stretch="Uniform" Fill="#10B981" Data="{StaticResource IconRefresh}" />
        </Button>
      </Grid>

      <!-- Objects Accordion / ScrollViewer -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <!-- Pinned Section -->
          <Expander Header="📌 Pinned"
                    IsExpanded="True"
                    IsVisible="{Binding HasPinnedItems}"
                    Background="Transparent"
                    BorderThickness="0">
            <ListBox ItemsSource="{Binding FilteredPinnedItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,4,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:TableOrView">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="📄 View Data"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenTableDataCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="⚙️ View Structure &amp; DDL"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenTablePropertiesCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📌 Unpin from Sidebar"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).TogglePinCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="📋 Copy Name"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CopyTableNameCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📋 Copy Qualified Name"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CopyQualifiedNameCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="⚡ Generate SQL">
                          <MenuItem Header="🔍 SELECT * (Limit 100)"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateSelectQueryCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="➕ INSERT Template"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateInsertQueryCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="📜 CREATE Script (DDL)"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateCreateScriptCommand}"
                                    CommandParameter="{Binding}" />
                        </MenuItem>
                      </ContextMenu>
                    </Grid.ContextMenu>

                    <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="#F59E0B"
                          Data="{StaticResource IconPin}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#FDE68A" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <!-- Quick Action Buttons -->
                    <Button Grid.Column="2"
                            Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).TogglePinCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Padding="4,2"
                            ToolTip.Tip="Unpin from Sidebar">
                      <Path Width="11" Height="11" Stretch="Uniform" Fill="#F59E0B" Data="{StaticResource IconPin}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>

          <!-- Tables Section -->
          <Expander Header="Tables" IsExpanded="True" Background="Transparent" BorderThickness="0">
            <ListBox ItemsSource="{Binding FilteredTables}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,4,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:TableOrView">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="📄 View Data"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenTableDataCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="⚙️ View Structure &amp; DDL"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenTablePropertiesCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📌 Pin / Unpin Table"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).TogglePinCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="📋 Copy Table Name"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CopyTableNameCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📋 Copy Qualified Name"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CopyQualifiedNameCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="⚡ Generate SQL">
                          <MenuItem Header="🔍 SELECT * (Limit 100)"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateSelectQueryCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="➕ INSERT Template"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateInsertQueryCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="📜 CREATE Script (DDL)"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateCreateScriptCommand}"
                                    CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="⚠️ TRUNCATE TABLE"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateTruncateQueryCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="🗑️ DROP TABLE"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateDropQueryCommand}"
                                    CommandParameter="{Binding}" />
                        </MenuItem>
                      </ContextMenu>
                    </Grid.ContextMenu>

                    <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#10B981"
                          Data="{StaticResource IconTable}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#F1F5F9"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <!-- Quick Action Buttons -->
                    <Button Grid.Column="2"
                            Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).TogglePinCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Padding="4,2"
                            ToolTip.Tip="Pin / Unpin Table">
                      <Path Width="11" Height="11" Stretch="Uniform" Fill="#64748B" Data="{StaticResource IconPin}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>

          <!-- Views Section -->
          <Expander Header="Views" IsExpanded="True" Background="Transparent" BorderThickness="0">
            <ListBox ItemsSource="{Binding FilteredViews}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,4,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:TableOrView">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="📄 View Data"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenTableDataCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="⚙️ View Structure &amp; Columns"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenTablePropertiesCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📜 View Definition (DDL)"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateCreateScriptCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📌 Pin / Unpin View"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).TogglePinCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="📋 Copy View Name"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CopyTableNameCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="📋 Copy Qualified Name"
                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CopyQualifiedNameCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="⚡ Generate SQL">
                          <MenuItem Header="🔍 SELECT * (Limit 100)"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateSelectQueryCommand}"
                                    CommandParameter="{Binding}" />
                          <MenuItem Header="📜 CREATE VIEW Script"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateCreateScriptCommand}"
                                    CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="🗑️ DROP VIEW"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).GenerateDropQueryCommand}"
                                    CommandParameter="{Binding}" />
                        </MenuItem>
                      </ContextMenu>
                    </Grid.ContextMenu>

                    <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#60A5FA"
                          Data="{StaticResource IconView}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#F1F5F9"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2"
                            Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).TogglePinCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Padding="4,2"
                            ToolTip.Tip="Pin / Unpin View">
                      <Path Width="11" Height="11" Stretch="Uniform" Fill="#64748B" Data="{StaticResource IconPin}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>

          <!-- Saved Queries Section -->
          <Expander Header="Saved Queries" IsExpanded="False" Background="Transparent" BorderThickness="0">
            <ListBox ItemsSource="{Binding SavedQueries}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,4,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="entities:FavoriteQueryEntity">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Fill="#FBBF24"
                          Data="{StaticResource IconPlay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="#F1F5F9"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenSavedQueryCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Padding="4,2">
                      <TextBlock Text="Open" FontSize="10" Foreground="#FBBF24" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>

          <!-- History Section -->
          <Expander Header="Query History" IsExpanded="False" Background="Transparent" BorderThickness="0">
            <ListBox ItemsSource="{Binding QueryHistory}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,4,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="entities:QueryHistoryEntity">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding QueryText}" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).OpenHistoryItemCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Padding="4,2">
                      <TextBlock Text="Load" FontSize="10" Foreground="#34D399" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
